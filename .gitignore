# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# private source material (resumes contain a phone number) and local tool config with token fields
/content/
.mcp.json

# ride recordings and photo originals carry exact locations; only the
# processed copies (src/content/cycling/rides.json, public/off-the-clock/) ship
/data/rides/*
!/data/rides/.gitkeep
/data/privacy-zones.json
/photos/*
!/photos/.gitkeep
# raw recordings; the site serves the converted .mp4 files next to them
/public/projects/*.mov
/public/projects/*.gif

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
