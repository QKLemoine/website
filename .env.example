# Chat backend for the terminal. Any OpenAI-compatible /chat/completions API works.
# Local development with Ollama (free, runs on your machine):
CHAT_BASE_URL=http://localhost:11434/v1
CHAT_MODEL=llama3.2
# Ollama needs no key. Set this for a hosted provider; it is only read on the server.
CHAT_API_KEY=

# Public site origin, used for absolute URLs in metadata once a domain exists.
# NEXT_PUBLIC_SITE_URL=https://example.com
